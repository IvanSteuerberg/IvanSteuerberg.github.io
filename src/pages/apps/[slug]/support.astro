---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { apps, type AppData } from '../../../data/apps';
import AlarmaSupport from '../../../components/legal/alarma/SupportContent.astro';
import CocheSupport from '../../../components/legal/coche/SupportContent.astro';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppData;
}

const { app } = Astro.props;
---

<LegalLayout app={app} documentType="support">
  {app.slug === 'alarma-con-desafios' && <AlarmaSupport app={app} />}
  {app.slug === 'historial-coche' && <CocheSupport app={app} />}
</LegalLayout>
