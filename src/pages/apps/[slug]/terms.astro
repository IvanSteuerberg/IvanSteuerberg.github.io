---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { apps, type AppData } from '../../../data/apps';
import AlarmaTerms from '../../../components/legal/alarma/TermsContent.astro';
import CocheTerms from '../../../components/legal/coche/TermsContent.astro';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppData;
}

const { app } = Astro.props;
---

<LegalLayout app={app} documentType="terms">
  {app.slug === 'alarma-con-desafios' && <AlarmaTerms />}
  {app.slug === 'historial-coche' && <CocheTerms />}
</LegalLayout>
