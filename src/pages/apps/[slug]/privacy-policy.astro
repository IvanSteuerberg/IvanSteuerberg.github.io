---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { apps, type AppData } from '../../../data/apps';
import AlarmaPrivacy from '../../../components/legal/alarma/PrivacyContent.astro';
import CochePrivacy from '../../../components/legal/coche/PrivacyContent.astro';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppData;
}

const { app } = Astro.props;
---

<LegalLayout app={app} documentType="privacy">
  {app.slug === 'alarma-con-desafios' && <AlarmaPrivacy />}
  {app.slug === 'historial-coche' && <CochePrivacy />}
</LegalLayout>
