---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { apps, type AppData } from '../../../data/apps';
import AlarmaDataDeletion from '../../../components/legal/alarma/DataDeletionContent.astro';
import CocheDataDeletion from '../../../components/legal/coche/DataDeletionContent.astro';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppData;
}

const { app } = Astro.props;
---

<LegalLayout app={app} documentType="data-deletion">
  {app.slug === 'alarma-con-desafios' && <AlarmaDataDeletion app={app} />}
  {app.slug === 'historial-coche' && <CocheDataDeletion app={app} />}
</LegalLayout>
