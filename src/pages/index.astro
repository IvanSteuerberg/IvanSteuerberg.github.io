---
import BaseLayout from '../layouts/BaseLayout.astro';
import { developerInfo, apps } from '../data/apps';
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28">
    <!-- Background Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/3 left-1/3 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Google Play Store Developer Portfolio</span>
      </div>

      <!-- Main Title -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6">
        {developerInfo.name}
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-sky-300 to-cyan-400 mt-2">
          {developerInfo.brandName}
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-400 leading-relaxed mb-8">
        {developerInfo.bio}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href="#apps" 
          class="px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-lg shadow-indigo-600/25 transition-all transform hover:-translate-y-0.5"
        >
          Explorar aplicaciones
        </a>
        <a 
          href={`mailto:${developerInfo.contactEmail}`}
          class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-semibold text-sm transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Soporte y contacto
        </a>
      </div>

      <!-- Compliance summary pills -->
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto text-left">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80">
          <div class="text-emerald-400 font-bold text-sm flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Google Play Compliant
          </div>
          <p class="text-xs text-slate-400 mt-1">Políticas de privacidad y solicitudes de borrado auditables para cada app.</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80">
          <div class="text-sky-400 font-bold text-sm flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Privacidad Primero
          </div>
          <p class="text-xs text-slate-400 mt-1">Sin venta de datos ni rastreadores invasivos de comportamiento.</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80">
          <div class="text-indigo-400 font-bold text-sm flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Desarrollo Nativo
          </div>
          <p class="text-xs text-slate-400 mt-1">Apps Android ligeras, eficientes y con consumo mínimo de batería.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apps Catalog Section -->
  <section id="apps" class="max-w-6xl mx-auto px-4 sm:px-6 py-12 border-t border-slate-800/80">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">
          Aplicaciones Publicadas
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Catálogo oficial de aplicaciones Android y sus respectivos apartados legales.
        </p>
      </div>
      <span class="text-xs font-medium text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 self-start sm:self-auto">
        {apps.length} {apps.length === 1 ? 'aplicación disponible' : 'aplicaciones disponibles'}
      </span>
    </div>

    <!-- App Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {apps.map((app) => (
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-all flex flex-col justify-between group shadow-lg">
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${app.iconBg} flex items-center justify-center text-2xl shadow-md`}>
                  {app.iconEmoji}
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors">
                    {app.name}
                  </h3>
                  <span class="text-xs text-slate-400 font-medium">
                    {app.category} · v{app.version}
                  </span>
                </div>
              </div>

              {app.status === 'published' ? (
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  En Google Play
                </span>
              ) : (
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  Próximamente
                </span>
              )}
            </div>

            <p class="text-sm text-slate-300 mb-4 line-clamp-2">
              {app.description}
            </p>

            <!-- Features Highlights -->
            <ul class="space-y-1.5 mb-6 text-xs text-slate-400">
              {app.features.slice(0, 3).map((feature) => (
                <li class="flex items-center gap-2">
                  <span class="text-indigo-400 font-bold">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Links Section -->
          <div class="pt-4 border-t border-slate-800/80 space-y-3">
            <div class="flex items-center gap-2">
              <a 
                href={`/apps/${app.slug}/`}
                class="flex-1 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold text-center transition-colors"
              >
                Ver Ficha Completa
              </a>
              {app.playStoreUrl && (
                <a 
                  href={app.playStoreUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 py-2 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold text-center transition-colors shadow-sm"
                >
                  Google Play ↗
                </a>
              )}
            </div>

            <!-- Direct Google Play Legal Links -->
            <div class="flex items-center justify-between text-xs text-slate-400 pt-1">
              <a 
                href={`/apps/${app.slug}/privacy-policy/`} 
                class="hover:text-indigo-400 transition-colors underline underline-offset-2"
                title="URL para Google Play Console"
              >
                Política de Privacidad
              </a>
              <span class="text-slate-700">•</span>
              <a 
                href={`/apps/${app.slug}/data-deletion/`} 
                class="hover:text-indigo-400 transition-colors underline underline-offset-2"
                title="URL de solicitud de borrado de datos"
              >
                Borrado de Datos
              </a>
              <span class="text-slate-700">•</span>
              <a 
                href={`/apps/${app.slug}/terms/`} 
                class="hover:text-indigo-400 transition-colors underline underline-offset-2"
              >
                Términos
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact and Support Section -->
  <section id="contacto" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-slate-800/80">
    <div class="max-w-2xl mx-auto p-8 rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 text-center shadow-xl">
      <div class="w-12 h-12 rounded-2xl bg-indigo-600/10 text-indigo-400 border border-indigo-500/20 flex items-center justify-center mx-auto mb-4 text-xl">
        ✉
      </div>
      <h2 class="text-2xl font-bold text-white mb-2">Contacto y Soporte al Usuario</h2>
      <p class="text-sm text-slate-400 mb-6">
        Si tienes consultas técnicas, problemas con una app o deseas ejercer tus derechos sobre tus datos, puedes contactarnos directamente:
      </p>

      <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-slate-900 border border-slate-800 text-slate-200 font-mono text-sm sm:text-base select-all mb-4">
        <span>{developerInfo.contactEmail}</span>
      </div>

      <p class="text-xs text-slate-400">
        Respondemos a todas las consultas de usuarios de Google Play en un plazo máximo de 24-48 horas laborables.
      </p>
    </div>
  </section>
</BaseLayout>
